# Public build-time variable (safe to expose, baked into the client bundle)
VITE_SITE_URL=https://REPLACE-WITH-DOMAIN
VITE_TURNSTILE_SITE_KEY=

# Server-side secrets — set these in Cloudflare Pages as encrypted secrets.
# Never commit real values. For local dev put them in .dev.vars instead.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
